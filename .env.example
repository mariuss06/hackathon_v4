# Copy to .env.local (local dev) or set the same names in your host's dashboard (Vercel / Netlify / Railway).
# Everything is optional: without Supabase the app runs in guest mode with data saved in the browser,
# and the Demo account (/login, /demo?plan=starter|pro|business) always works without any key.

# Public base URL of the deployment, e.g. https://credifit.ro (no trailing slash).
# Used for absolute links such as the ANAF OAuth callback. On Vercel it falls back to VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL,
# elsewhere to the origin of the current request. Client code always calls the API with relative paths (/api/...).
NEXT_PUBLIC_SITE_URL=

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
# Public anon key: enables accounts (Supabase Auth, email + password) in the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only key used by the API routes. Never expose it in client code.
SUPABASE_SERVICE_ROLE_KEY=

# Admin panel (/admin)
# Comma-separated emails that are always admins (in addition to profiles.role = 'admin').
ADMIN_EMAILS=
# Hackathon demo admin: the code typed on /login ("Acces demo admin") opens /admin for 8 hours. Empty = disabled.
ADMIN_DEMO_CODE=

# RO e-Factura (SPV) automatic import — app registered in the ANAF developer portal (OAuth 2.0, digital certificate)
ANAF_OAUTH_CLIENT_ID=
ANAF_OAUTH_CLIENT_SECRET=
# Must match the URL registered at ANAF, e.g. https://credifit.ro/api/spv/callback.
# Empty = <NEXT_PUBLIC_SITE_URL, or the request origin>/api/spv/callback.
ANAF_OAUTH_REDIRECT_URI=

# External quiz website (optional)
NEXT_PUBLIC_EXTERNAL_QUIZ_URL=
# Shared secret the quiz site sends in the x-quiz-secret header of POST /api/quiz
QUIZ_WEBHOOK_SECRET=
